# Nix build products
result
.directory
result-*
*.drv

# direnv / local env
.direnv/
.env
.env.*

# VM images
*.qcow2

# Age private key, decrypted copies, and original secret paths. Ciphertext under secrets/*.sops is committed.
secrets/*
!secrets/README.md
!secrets/*.sops
*.age
*.pem
*.dec
keys.txt
id_rsa
id_ed25519

# Editor and agent metadata
.cursor/
.claude/

# Neovim plugin checkouts and vim-plug's loader. PlugInstall fetches these.
home/nvim/plugged/
home/nvim/pack/
home/nvim/autoload/

# Local Windows fonts. The default directory is outside this repo. Ignore font
# bytes so a checkout-relative directory cannot be committed.
fonts/windows/
*.ttf
*.otf
*.TTF
*.OTF
