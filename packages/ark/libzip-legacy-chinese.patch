+/* Ark-local compatibility policy for legacy Chinese ZIP names. UTF-8 and
+ * Unicode extra fields have already been resolved by libzip before this path.
+ * GB18030 is a strict superset of GBK. Ambiguous legacy encodings cannot be
+ * identified perfectly; invalid GB18030 retains the original CP437 fallback.
+ */
+static zip_uint8_t *
+_zip_legacy_chinese_to_utf8(const zip_uint8_t *raw, zip_uint32_t length, zip_uint32_t *converted_length) {
+    iconv_t converter;
+    char *input, *output, *cursor;
+    size_t input_left, output_left, result;
+
+    if (length == 0 || length > UINT32_MAX / 4 || (size_t)length > (SIZE_MAX - 1) / 4)
+        return NULL;
+    converter = iconv_open("UTF-8", "GB18030");
+    if (converter == (iconv_t)-1)
+        return NULL;
+    output_left = (size_t)length * 4;
+    output = malloc(output_left + 1);
+    if (output == NULL) {
+        iconv_close(converter);
+        return NULL;
+    }
+    input = (char *)raw;
+    input_left = length;
+    cursor = output;
+    result = iconv(converter, &input, &input_left, &cursor, &output_left);
+    iconv_close(converter);
+    if (result != 0 || input_left != 0) {
+        free(output);
+        return NULL;
+    }
+    *cursor = '\0';
+    *converted_length = (zip_uint32_t)(cursor - output);
+    return (zip_uint8_t *)output;
 }
 
 
